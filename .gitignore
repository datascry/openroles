# Build output
dist/
.astro/
.cache/
.output/
build/

# Per-worktree agent state (Claude Code launch.json etc).
.claude/

# Copied at site build time from node_modules; regenerated by `bun run vfs:copy`.
site/public/sqlite-vfs/

# Fixture SQLite + manifest produced by Playwright globalSetup.
site/public/data/

# Dependencies
node_modules/

# Test artifacts
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
playwright/.cache/

# Generated build outputs (built fresh in CI; never committed)
data/*.sqlite
data/*.sqlite.gz
data/*.parquet
data/manifest.json
data/run-report.json
data/run-report.md
data/scrape-inputs/
data/scrape-outputs/
data/tenants-merged.json

# Tenant lists are checked-in inputs (refreshed weekly by .github/workflows/weekly-harvest.yml)
# Keep checked-in seed dataset
!data/seed/

# Harvest runtime caches — large + machine-local + always re-fetchable.
# Per-ATS state files (data/harvest-state/<ats>.json) ARE tracked: they
# record which CC-MAIN snapshots have been processed so incremental
# harvests skip already-done work. The cluster.idx cache is too big
# (~100 MB × 120 collections = 14 GB) and the collinfo cache is a
# 24h-TTL runtime artifact, not source.
data/harvest-state/cluster-idx/
data/harvest-state/_collinfo.json

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
.zed/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.tsbuildinfo
.turbo/
.parcel-cache/
