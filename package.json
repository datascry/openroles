{
  "name": "openroles",
  "version": "0.0.0",
  "private": true,
  "description": "Static, queryable job board aggregator across major Applicant Tracking Systems",
  "license": "MIT",
  "author": "datascry",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "shared",
    "scraper",
    "site"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test --coverage --path-ignore-patterns='**/tests/e2e/**'",
    "test:watch": "bun test --watch --path-ignore-patterns='**/tests/e2e/**'",
    "scrape": "bun run --filter @openroles/scraper scrape",
    "harvest": "bun run --filter @openroles/scraper harvest",
    "build-db": "bun run --filter @openroles/scraper build-db",
    "report": "bun run --filter @openroles/scraper report",
    "dev": "bun run --filter @openroles/site dev",
    "build": "bun run --filter @openroles/site build",
    "preview": "bun run --filter @openroles/site preview",
    "e2e": "bun run --filter @openroles/site e2e",
    "lighthouse": "bun run --filter @openroles/site lighthouse",
    "size-limit": "bun run --filter @openroles/site size-limit",
    "changelog": "git-cliff --output CHANGELOG.md"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@commitlint/cli": "20.5.2",
    "@commitlint/config-conventional": "20.5.0",
    "@types/bun": "1.3.13",
    "lefthook": "2.1.6",
    "typescript": "6.0.3"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
