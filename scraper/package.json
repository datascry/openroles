{
  "name": "@openroles/scraper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ATS scrapers, harvester, and SQLite database builder",
  "license": "MIT",
  "bin": {
    "openroles-scrape": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "scrape": "bun run src/cli.ts scrape",
    "harvest": "bun run src/cli.ts harvest",
    "build-db": "bun run src/cli.ts build-db",
    "report": "bun run src/cli.ts report"
  },
  "dependencies": {
    "@openroles/shared": "workspace:*",
    "fast-xml-parser": "5.7.2",
    "p-limit": "7.3.0",
    "pino": "10.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "fast-check": "4.7.0",
    "msw": "2.13.6"
  }
}
