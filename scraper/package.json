{
  "name": "@openroles/scraper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ATS scrapers, harvester, and SQLite database builder",
  "license": "MIT",
  "bin": {
    "openroles-scrape": "./bin/openroles-scrape.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "scrape": "bun run bin/openroles-scrape.ts scrape",
    "harvest": "bun run bin/openroles-scrape.ts harvest",
    "build-db": "bun run bin/openroles-scrape.ts build-db",
    "report": "bun run bin/openroles-scrape.ts report"
  },
  "dependencies": {
    "@openroles/shared": "workspace:*",
    "fast-xml-parser": "5.7.2",
    "p-limit": "7.3.0",
    "pino": "10.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "fast-check": "4.7.0",
    "msw": "2.14.2"
  }
}
