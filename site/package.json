{
  "name": "@openroles/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Static site for openroles — Astro 6 with one Svelte filter island",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "bun run scripts/copy-sqlite-vfs.ts && bun --bun astro dev",
    "build": "bun run scripts/copy-sqlite-vfs.ts && bun --bun astro build",
    "preview": "bun --bun astro preview",
    "e2e": "playwright test",
    "lighthouse": "playwright test --project=lighthouse",
    "size-limit": "size-limit",
    "vfs:copy": "bun run scripts/copy-sqlite-vfs.ts"
  },
  "dependencies": {
    "@astrojs/svelte": "8.1.0",
    "@openroles/shared": "workspace:*",
    "astro": "6.2.1",
    "open-props": "1.7.23",
    "sql.js": "1.14.1",
    "sql.js-httpvfs": "0.8.12",
    "svelte": "5.55.5"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.2",
    "@axe-core/playwright": "4.11.2",
    "@playwright/test": "1.59.1",
    "@size-limit/file": "12.1.0",
    "@testing-library/svelte": "5.3.1",
    "@types/bun": "1.3.13",
    "fast-check": "4.7.0",
    "lighthouse": "13.1.0",
    "playwright-lighthouse": "4.0.0",
    "size-limit": "12.1.0"
  }
}
