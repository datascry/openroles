---
// Pre-rendered top-50 role rows for instant first paint. Astro emits
// these into the static HTML at build time so users see real role
// content before any JS executes — critical for slow connections
// where the FilterTable's slim-index JSON takes seconds to load.
//
// Visual consistency with the FilterTable's rendered rows is
// important: we reuse the same `.job-cell--role / --location / --level
// / --posted` cell classes so the layout doesn't reflow when the
// Svelte island hydrates and replaces this aside. CSS in index.astro
// hides this element once `ul.results > li` exists in the DOM
// (FilterTable has rendered its own first row), via `:has()`.
//
// Also emits the same row data as a `<script type="application/json"
// id="first-paint-data">` so the FilterTable can opportunistically
// use these rows as its initial state — no extra round-trip just to
// repopulate the same 50 roles.

import type { FirstPaintRow } from "../lib/db.ts";

interface Props {
  readonly rows: ReadonlyArray<FirstPaintRow>;
  readonly basePath: string;
}

// basePath used to be needed for the per-role detail href; ADR-0012
// removed that page. Keep the prop for API parity (callers still pass
// it) but don't reference it inside the template.
// biome-ignore lint/correctness/noUnusedVariables: kept for caller-API parity
const { rows, basePath: _basePath }: Props = Astro.props;

const ATS_PRETTY: Record<string, string> = {
  greenhouse: "Greenhouse",
  lever: "Lever",
  ashby: "Ashby",
  bamboohr: "BambooHR",
  workday: "Workday",
  icims: "iCIMS",
  recruitee: "Recruitee",
  breezy: "Breezy",
  personio: "Personio",
  workable: "Workable",
  teamtailor: "Teamtailor",
  smartrecruiters: "SmartRecruiters",
  csod: "Cornerstone",
  taleo: "Taleo",
  ultipro: "UltiPro",
  jobvite: "Jobvite",
  zohorecruit: "Zoho Recruit",
  talentlyft: "TalentLyft",
  pinpointhq: "Pinpoint HQ",
  applicantpro: "ApplicantPro",
  applicantstack: "ApplicantStack",
  homerun: "Homerun",
  factorial: "Factorial",
  eightfold: "Eightfold",
};

function formatAge(postedAt: string | null, firstSeenAt: string): string {
  // Match the FilterTable's age formatter shape — keeps SSR/CSR
  // rendering visually identical so there's no jump on hydrate.
  const iso = postedAt ?? firstSeenAt;
  const ts = Date.parse(iso);
  if (!Number.isFinite(ts)) return "—";
  const ageMs = Date.now() - ts;
  const days = Math.floor(ageMs / 86_400_000);
  if (days <= 0) return "TODAY";
  if (days === 1) return "1D AGO";
  if (days < 7) return `${days}D AGO`;
  if (days < 30) return `${Math.floor(days / 7)}W AGO`;
  if (days < 365) return `${Math.floor(days / 30)}MO AGO`;
  return `${Math.floor(days / 365)}Y AGO`;
}

function isFresh(postedAt: string | null, firstSeenAt: string): boolean {
  const iso = postedAt ?? firstSeenAt;
  const ts = Date.parse(iso);
  if (!Number.isFinite(ts)) return false;
  return Date.now() - ts < 86_400_000 * 3; // 3 days
}
---

{
  rows.length > 0 && (
    <aside id="first-paint-rows" aria-hidden="false" data-row-count={rows.length}>
      {/* Search-bar + filter-bar placeholder. Reserves the vertical
          space the SearchBar + filter-chip strip will occupy after
          hydration so the role list doesn't lurch upward when the
          FilterTable mounts. Heights are measured against the live
          hydrated chrome on each viewport:
            - desktop ≥ 800 px: ~170 px (search 129 + filter-bar 31 + gaps)
            - narrower: ~204 px (search 121 + filter-bar 73 + gaps;
              the chip strip wraps to more rows on mobile)
          Mismatch costs CLS — the chrome block IS the hydrated
          chrome's shadow. */}
      <div class="first-paint-chrome" aria-hidden="true"></div>
      {/* Two-column wrapper mirroring FilterTable's .layout-grid so
          the SSR rows occupy the same horizontal slot the hydrated
          rows will. The empty .first-paint-sidebar-slot reserves the
          ~320 px sidebar column at ≥800 px viewports. */}
      <div class="first-paint-layout">
        <div class="first-paint-sidebar-slot" aria-hidden="true" />
        <div class="first-paint-main">
      <ul class="results" role="list">
        {rows.map((r) => {
          const stale = r.is_stale;
          const fresh = !stale && isFresh(r.posted_at, r.first_seen_at);
          const age = formatAge(r.posted_at, r.first_seen_at);
          // ADR-0012: row title links directly to the source ATS apply
          // page. There is no intermediate role-detail page.
          return (
            <li class={`job${stale ? " is-stale" : ""}`}>
              <div class="job-cell job-cell--role">
                <h3 class="company">
                  <span class="company-name">{r.company}</span>
                  {stale ? (
                    <span class="stale-badge">STALE</span>
                  ) : fresh ? (
                    <span class="new-badge" aria-label="new">NEW</span>
                  ) : null}
                  {r.is_recruiter_post && (
                    <span class="recruiter-badge" aria-label="recruiter posting">RECRUITER</span>
                  )}
                </h3>
                <a
                  href={r.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="job-title"
                >
                  {r.title}
                </a>
              </div>
              <div
                class={`job-cell job-cell--location${!r.location_text && !r.workplace_type ? " is-empty" : ""}`}
              >
                {r.location_text ?? ""}
                {r.workplace_type && (
                  <>
                    {r.location_text && <span class="rule" aria-hidden="true">·</span>}
                    <span class="wt">{r.workplace_type}</span>
                  </>
                )}
              </div>
              <div class={`job-cell job-cell--level${!r.level ? " is-empty" : ""}`}>
                {r.level ?? ""}
              </div>
              <div class="job-cell job-cell--posted">
                <span class={`age${fresh ? " is-new" : ""}`}>{age}</span>
              </div>
              <div class="job-cell job-cell--actions">
                <span class="job-action view-link">
                  <a
                    href={r.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="job-action apply"
                  >
                    Apply →
                  </a>
                </span>
              </div>
            </li>
          );
        })}
      </ul>
      <p class="first-paint-note" aria-live="polite">
        <small>
          Loading filter index… interactive filters available in a moment.
        </small>
      </p>
        </div>
      </div>
    </aside>
  )
}

{
  /* Same row payload embedded as JSON so the FilterTable can use it as
   * initial state on hydrate, avoiding a re-fetch of data we already
   * have in the DOM. id matches what site/src/components/FilterTable.svelte
   * looks for on mount. */
}
{
  rows.length > 0 && (
    <script
      type="application/json"
      id="first-paint-data"
      set:html={JSON.stringify(rows)}
    />
  )
}

<style is:global>
  /* All rules in this block are intentionally global (no Astro cid
     scoping). The previous scoped variant compiled to selectors like
     `.first-paint-search[data-astro-cid-XXX]` whose runtime
     specificity / load-order behaviour produced computed height = 0
     in the deployed bundle — the placeholder collapsed and the role
     list dropped ~218 px when the FilterTable hydrated, costing
     CLS = 0.56 (well into the "poor" band). `is:global` removes the
     cid attribute selector entirely so the rules match unconditionally. */

  /* Atomic swap between SSR pre-paint and the hydrated FilterTable
     island. Both elements occupy the same logical position in <main>
     (the FilterTable is a sibling immediately after FirstPaintRows),
     but they take turns being in flow:

       - Until the FilterTable has rendered at least one role row, its
         astro-island is `display: none` and the SSR aside is the only
         visible result list.
       - Once the island has rendered a row, the SSR aside hides and
         the island becomes visible in the SAME paint frame.

     This eliminates the ~7200 px layout shift that occurred when the
     two were both in flow at different times: the island used to sit
     below the SSR aside, hidden off-screen, and rocket up by the
     aside's full height when the aside switched to `display: none`.

     `:has()` ships in every major browser since early 2023. The
     selector matches the FilterTable island specifically via its
     `opts` attribute (Astro embeds the component name there); other
     islands on the page (none today, but defensively scoped) won't
     trigger the swap. */

  /* When the FilterTable island has rendered rows (i.e. its UL has at
     least one <li.job>), hide the SSR aside. The island renders rows
     immediately on hydration via the embedded SSR seed data, so this
     swap fires the moment the FilterTable mounts — no transition
     frame where both are visible, no transition frame where neither
     is, no CLS event from the SSR's height vanishing while the
     island's content is still loading. */
  main:has(astro-island[opts*="FilterTable"] ul.results > li.job) #first-paint-rows {
    display: none;
  }

  #first-paint-rows {
    display: block;
  }

  /* Single block that reserves the FULL chrome height (SearchBar +
     filter-bar + their gaps) at the SSR pre-paint stage. Measured
     against the live hydrated chrome:
       - default (mobile, < 800 px): chip strip wraps to multiple
         rows so the chrome runs ~204 px tall.
       - desktop (≥ 800 px): chips fit on one row, chrome is ~170 px. */
  .first-paint-chrome {
    height: 204px;
    margin-block-end: var(--space-2);
  }
  @media (min-width: 800px) {
    .first-paint-chrome {
      height: 170px;
    }
  }

  /* Single-column layout below the sidebar breakpoint — the placeholder
     collapses, rows take the full width as they would post-hydration. */
  .first-paint-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  .first-paint-sidebar-slot { display: none; }
  .first-paint-main { min-width: 0; }

  /* At desktop widths, mirror the hydrated FilterTable's grid exactly:
     320-340 px sidebar + 1fr main column. The placeholder is invisible
     but reserves the same horizontal slot, so the role rows render at
     their post-hydration width and don't shift left when the sidebar
     mounts. */
  @media (min-width: 800px) {
    .first-paint-layout {
      grid-template-columns: minmax(280px, 340px) 1fr;
    }
    .first-paint-sidebar-slot {
      display: block;
      min-height: 1px;
    }
  }

  .first-paint-note {
    margin-top: var(--space-3);
    color: var(--color-ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-1);
    letter-spacing: var(--track-wide);
    text-align: center;
    text-transform: uppercase;
  }
</style>
