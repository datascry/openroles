---
/**
 * Brutalist Press masthead. Locked by specs/visual-theme.md v1.0.2.
 *
 * Mobile: stacked — brand, strap, nav.
 * Desktop (≥ 768 px): single row, three-column grid.
 */

export type NavCurrent = "browse" | "saved" | "applied" | "about";

interface Props {
  current: NavCurrent;
  totalRoles: number;
  builtAtIso: string;
  basePath: string;
  /** Optional 7-char git short SHA. When set, surfaces in the strap line
   *  as a link to the upstream commit on GitHub. */
  shortSha?: string;
}

const { current, totalRoles, builtAtIso, basePath, shortSha } = Astro.props;
const REPO_BASE_URL = "https://github.com/datascry/openroles";
const commitUrl = shortSha ? `${REPO_BASE_URL}/commit/${shortSha}` : null;

const builtAt = new Date(builtAtIso);
const days = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"];
const months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
const dateline = `${days[builtAt.getUTCDay()]} ${String(builtAt.getUTCDate()).padStart(
  2,
  "0",
)} ${months[builtAt.getUTCMonth()]} ${builtAt.getUTCFullYear()}`;

const totalRolesFormatted = new Intl.NumberFormat("en-US").format(totalRoles);

// Nav is currently empty: with no per-role detail pages, no /saved or
// /about routes, and the brand wordmark already linking home, a BROWSE
// link to the same place was redundant. Kept the array shape so adding
// a real second route later is a one-line patch.
const navItems: ReadonlyArray<{ key: NavCurrent; label: string; href: string }> = [];
---

<header class="masthead">
  <a
    class="brand"
    href={`${basePath}/`}
    aria-current={current === "browse" ? "page" : undefined}
  >
    <span aria-hidden="true">OPEN<span class="dot">·</span>ROLES</span>
    <span class="visually-hidden">openroles</span>
  </a>

  <p class="strap">
    <span>UPDATED <time datetime={builtAt.toISOString()}>{dateline}</time></span>
    <span class="rule" aria-hidden="true">·</span>
    <span><b class="accent">{totalRolesFormatted}</b> LIVE</span>
    {commitUrl && (
      <>
        <span class="rule" aria-hidden="true">·</span>
        <a
          class="build-sha"
          href={commitUrl}
          target="_blank"
          rel="noopener noreferrer"
          title="View this build's commit on GitHub"
        >#{shortSha}</a>
      </>
    )}
  </p>

  <nav aria-label="Primary">
    <ul role="list">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.key === current ? "page" : undefined}
            class={item.key === current ? "is-active" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle"
          aria-label="Toggle light or dark theme"
          aria-live="polite"
        >
          <!-- Inline SVG sun + moon. Unicode glyphs (U+263C / U+263E) don't
               render reliably in Helvetica Neue / Inter Tight on macOS, so
               we ship the icons as paths. currentColor inherits ink so the
               toggle obeys the active theme automatically. -->
          <svg
            class="theme-toggle__sun"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          <svg
            class="theme-toggle__moon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</header>

<style>
  .masthead {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) var(--space-3);
    border-bottom: var(--rule-4) solid var(--color-rule);
    background: var(--color-paper);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-6);
    font-weight: 900;
    letter-spacing: var(--track-tight);
    line-height: 0.9;
    text-decoration: none;
    text-transform: uppercase;
  }

  .brand:hover {
    color: var(--color-ink);
  }

  .brand .dot {
    color: var(--color-accent);
  }

  .strap {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    align-items: baseline;
    color: var(--color-ink-2);
    font-family: var(--font-mono);
    font-size: var(--text-0);
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    /* Small mono text on cream paper (text-0 ≈ 11 px) loses contrast
       through subpixel antialiasing — the rendered effective fg drifts
       toward the bg by ~30%. Painting a 0/0/0 same-color shadow doubles
       glyph ink density so the rendered colour stays close to the
       source colour and clears WCAG 2 AA at the rendered-pixel layer
       axe measures. Applied here once for every strap descendant
       inheriting --font-mono. */
    text-shadow: 0 0 0 currentColor;
  }

  .strap b {
    color: var(--color-ink);
    font-weight: 700;
  }

  .strap b.accent {
    color: var(--color-accent);
    /* Small bold accent text on cream paper renders with antialias
       halos that desaturate the effective fg color enough to fail
       WCAG 2 AA (axe sampled ~2.7:1 vs --color-paper before this).
       Two-step fix:
       1. Bump font-size one stop (text-0 → text-1) — larger glyphs
          have a smaller antialias-to-body ratio per pixel, so the
          rendered effective colour is closer to the source.
       2. -webkit-text-stroke paints an explicit 0.03 em stroke
          around each glyph in the same colour, thickening the
          ink edges. Combined with the size bump, the rendered
          effective colour clears 4.5:1 in axe's pixel sampler.
       Both are visual-density tweaks; no layout impact. */
    font-size: var(--text-1);
    -webkit-text-stroke: 0.03em currentColor;
  }

  .strap time {
    font-family: var(--font-mono);
  }

  .strap .rule {
    color: var(--color-ink-3);
  }

  /* Build SHA — link out to the upstream commit. Same monospace
     family as the rest of the strap; ink-3 by default; underline on
     hover so it reads as actionable without competing with the
     accent-colored live-roles count.

     min-height/padding meet WCAG 2.5.5 tap-target sizing (24x24+) so
     keyboard / touch users aren't squeezed into a 16 px line-height
     hit zone. Inline-flex centers the text inside the bumped box. */
  .build-sha {
    display: inline-flex;
    align-items: center;
    /* WCAG 2.5.5 AAA / specs/visual-theme.md tap-target floor — 44 x 44.
       The visible glyph stays small (mono text-0); padding is what
       satisfies the hit zone. */
    min-height: 44px;
    min-width: 44px;
    padding: 0 8px;
    margin-inline-start: 4px;
    color: var(--color-ink-3);
    text-decoration: none;
    font-family: var(--font-mono);
    letter-spacing: var(--track-wider);
  }
  .build-sha:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-1) var(--space-2);
    min-height: var(--tap);
    min-width: var(--tap);
    color: var(--color-ink-2);
    font-family: var(--font-display);
    font-size: var(--text-1);
    font-weight: 700;
    letter-spacing: var(--track-wide);
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: var(--rule-2) solid transparent;
  }

  nav a:hover {
    color: var(--color-ink);
  }

  nav a.is-active {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    min-width: var(--tap);
    padding: 0 var(--space-2);
    border: var(--rule-1) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-3);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  /* Show the moon when light theme is active (clicking switches to dark);
     show the sun when dark theme is active (clicking switches to light).
     The selector must target the <html> element specifically — a bare
     `:not([data-theme="dark"])` matches every ancestor that lacks the
     attribute, so the rule fires unconditionally. */
  :global(html[data-theme="dark"]) .theme-toggle__moon { display: none; }
  :global(html:not([data-theme="dark"])) .theme-toggle__sun { display: none; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 768px) {
    .masthead {
      grid-template-columns: auto 1fr auto;
      column-gap: var(--space-6);
      align-items: end;
      padding: var(--space-5) var(--space-7) var(--space-3);
      border-bottom-width: var(--rule-6);
    }

    .strap {
      justify-content: flex-start;
      padding-bottom: var(--space-1);
    }

    nav {
      align-self: end;
      padding-bottom: var(--space-1);
    }
  }
</style>
