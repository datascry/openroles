---
import RoleActions from "../../components/RoleActions.svelte";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { dataDirIsPopulated, openSiteDb, selectAllJobsForStatic } from "../../lib/db.ts";
import { jsonLdSafe } from "../../lib/json-ld.ts";
import { shortIdFromJobId } from "../../lib/role-detail-sql.ts";

// Static path-based role detail page. Each role gets a fully-rendered
// HTML page at build time so social/Slack/Twitter unfurls work, non-Google
// crawlers can index, and Google for Jobs picks up the JSON-LD
// JobPosting from the very first crawl pass. See specs/role-detail.md.
//
// Build cost is O(n) over jobs — at the projected bootstrap-final corpus
// of ~30-50k roles this adds ~5-10 min to the daily refresh. Tarball size
// grows by ~5KB/role; well within GitHub Pages' 1GB soft cap.
//
// The save/apply/ignore controls hydrate via the small RoleActions
// island; everything else (title, description, location, JSON-LD) is in
// the static HTML.

export const prerender = true;

interface JobLikeRow {
  id: string;
  ats: string;
  tenant_slug: string;
  title: string;
  company: string;
  description_excerpt?: string;
  level: string | null;
  workplace_type: string | null;
  is_recruiter_post: boolean;
  location_text?: string;
  location_country?: string;
  location_region?: string;
  compensation_min?: number;
  compensation_max?: number;
  compensation_currency?: string;
  department?: string;
  posted_at?: string;
  first_seen_at: string;
  is_stale?: boolean;
  url: string;
}

interface RolePageProps {
  id: string;
  ats: string;
  tenant_slug: string;
  title: string;
  company: string;
  description_excerpt?: string;
  level: string | null;
  workplace_type: string | null;
  is_recruiter_post: boolean;
  location_text?: string;
  location_country?: string;
  location_region?: string;
  compensation_min?: number;
  compensation_max?: number;
  compensation_currency?: string;
  department?: string;
  posted_at?: string;
  first_seen_at: string;
  is_stale: boolean;
  url: string;
  totalRoles: number;
  builtAtIso: string;
}

export async function getStaticPaths() {
  if (!dataDirIsPopulated()) return [];
  // Astro evaluates `getStaticPaths` in an isolated worker, so module-
  // scope helpers aren't reachable from inside this body. Define the
  // job→props transform locally to keep it in scope.
  const jobToRoleProps = (
    j: JobLikeRow,
    totalRolesArg: number,
    builtAtIsoArg: string,
  ): RolePageProps => ({
    id: j.id,
    ats: j.ats,
    tenant_slug: j.tenant_slug,
    title: j.title,
    company: j.company,
    level: j.level,
    workplace_type: j.workplace_type,
    is_recruiter_post: j.is_recruiter_post,
    first_seen_at: j.first_seen_at,
    is_stale: j.is_stale ?? false,
    url: j.url,
    totalRoles: totalRolesArg,
    builtAtIso: builtAtIsoArg,
    ...(j.description_excerpt !== undefined ? { description_excerpt: j.description_excerpt } : {}),
    ...(j.location_text !== undefined ? { location_text: j.location_text } : {}),
    ...(j.location_country !== undefined ? { location_country: j.location_country } : {}),
    ...(j.location_region !== undefined ? { location_region: j.location_region } : {}),
    ...(j.compensation_min !== undefined ? { compensation_min: j.compensation_min } : {}),
    ...(j.compensation_max !== undefined ? { compensation_max: j.compensation_max } : {}),
    ...(j.compensation_currency !== undefined
      ? { compensation_currency: j.compensation_currency }
      : {}),
    ...(j.department !== undefined ? { department: j.department } : {}),
    ...(j.posted_at !== undefined ? { posted_at: j.posted_at } : {}),
  });

  const site = openSiteDb();
  try {
    const jobs = selectAllJobsForStatic(site.db);
    // Hoist the manifest read once — passed through props so the
    // per-page template doesn't re-open the SQLite N times (audit M2).
    const totalRoles = site.manifest.total_rows;
    const builtAtIso = site.manifest.built_at;
    const seen = new Set<string>();
    const paths: { params: { short_id: string }; props: RolePageProps }[] = [];
    for (const j of jobs) {
      const short = shortIdFromJobId(j.id);
      if (seen.has(short)) continue;
      seen.add(short);
      paths.push({ params: { short_id: short }, props: jobToRoleProps(j, totalRoles, builtAtIso) });
    }
    return paths;
  } finally {
    site.close();
  }
}

const role = Astro.props as RolePageProps;
const { totalRoles, builtAtIso } = role;

const ATS_PRETTY: Record<string, string> = {
  greenhouse: "Greenhouse",
  lever: "Lever",
  ashby: "Ashby",
  bamboohr: "BambooHR",
  workday: "Workday",
  icims: "iCIMS",
  recruitee: "Recruitee",
  breezy: "Breezy",
  personio: "Personio",
  workable: "Workable",
  teamtailor: "Teamtailor",
  smartrecruiters: "SmartRecruiters",
  csod: "Cornerstone",
  taleo: "Taleo",
  ultipro: "UltiPro",
  jobvite: "Jobvite",
  zohorecruit: "Zoho Recruit",
  talentlyft: "TalentLyft",
  pinpointhq: "Pinpoint HQ",
  applicantpro: "ApplicantPro",
  applicantstack: "ApplicantStack",
  homerun: "Homerun",
  factorial: "Factorial",
  eightfold: "Eightfold",
};

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const atsPretty = ATS_PRETTY[role.ats] ?? role.ats;
const fullTitle = `${role.title} at ${role.company} · openroles`;
const description = role.description_excerpt ?? `Open role: ${role.title} at ${role.company}.`;

const datePosted = role.posted_at ?? role.first_seen_at;
const datePostedMs = Date.parse(datePosted);
// Per-spec: omit `validThrough` rather than emit a fabricated 90-day TTL
// off `now`. A NaN datePosted implies upstream data quality issues; better
// to leave the field absent than lie to Google for Jobs.
const validThrough = Number.isNaN(datePostedMs)
  ? undefined
  : new Date(datePostedMs + 90 * 86_400_000).toISOString();

let sourceHost = role.url;
try {
  sourceHost = new URL(role.url).host;
} catch {
  // role.url validation runs in JobSchema; this is defensive.
}

interface JobLocationLD {
  "@type": string;
  address: Record<string, string>;
}
interface JobPostingLD {
  "@context": string;
  "@type": string;
  title: string;
  description: string;
  datePosted: string;
  validThrough?: string;
  hiringOrganization: { "@type": string; name: string };
  url: string;
  jobLocationType?: string;
  jobLocation?: JobLocationLD;
  applicantLocationRequirements?: { "@type": string; name: string };
  baseSalary?: {
    "@type": string;
    currency: string;
    value: {
      "@type": string;
      minValue?: number;
      maxValue?: number;
      unitText: string;
    };
  };
}

// Skip the JobPosting JSON-LD entirely when the role has no description —
// Google for Jobs flags description-less postings as misleading and may
// deindex the whole site if too many appear. The page still renders fine
// (with a "no description" notice); we just don't claim structured data.
const emitJsonLd = role.description_excerpt !== undefined;

const jsonLd: JobPostingLD | null = emitJsonLd
  ? {
      "@context": "https://schema.org",
      "@type": "JobPosting",
      title: role.title,
      description,
      datePosted,
      ...(validThrough !== undefined ? { validThrough } : {}),
      hiringOrganization: { "@type": "Organization", name: role.company },
      url: role.url,
    }
  : null;

if (jsonLd !== null) {
  if (role.workplace_type === "remote") {
    jsonLd.jobLocationType = "TELECOMMUTE";
    if (role.location_country !== undefined) {
      jsonLd.applicantLocationRequirements = {
        "@type": "Country",
        name: role.location_country,
      };
    }
  }

  if (
    role.location_text !== undefined ||
    role.location_country !== undefined ||
    role.location_region !== undefined
  ) {
    const address: Record<string, string> = {};
    if (role.location_country) address.addressCountry = role.location_country;
    if (role.location_region) address.addressRegion = role.location_region;
    if (role.location_text) address.addressLocality = role.location_text;
    if (Object.keys(address).length > 0) {
      jsonLd.jobLocation = {
        "@type": "Place",
        address: { "@type": "PostalAddress", ...address },
      };
    }
  }

  if (role.compensation_min !== undefined || role.compensation_max !== undefined) {
    const cur = role.compensation_currency ?? "USD";
    jsonLd.baseSalary = {
      "@type": "MonetaryAmount",
      currency: cur,
      value: {
        "@type": "QuantitativeValue",
        ...(role.compensation_min !== undefined ? { minValue: role.compensation_min } : {}),
        ...(role.compensation_max !== undefined ? { maxValue: role.compensation_max } : {}),
        unitText: "YEAR",
      },
    };
  }
}

function relativeDate(iso: string): string {
  const t = Date.parse(iso);
  if (Number.isNaN(t)) return iso;
  const diffDays = Math.floor((Date.now() - t) / 86_400_000);
  if (diffDays < 1) return "today";
  if (diffDays === 1) return "yesterday";
  if (diffDays < 30) return `${diffDays} days ago`;
  const months = Math.floor(diffDays / 30);
  if (months === 1) return "1 month ago";
  if (months < 12) return `${months} months ago`;
  const years = Math.floor(months / 12);
  return years === 1 ? "1 year ago" : `${years} years ago`;
}

function formatComp(): string | null {
  const min = role.compensation_min;
  const max = role.compensation_max;
  const cur = role.compensation_currency;
  if (min === undefined && max === undefined) return null;
  const fmt = (n: number) => new Intl.NumberFormat("en-US").format(n);
  if (min !== undefined && max !== undefined)
    return `${fmt(min)} – ${fmt(max)}${cur ? ` ${cur}` : ""}`;
  if (min !== undefined) return `from ${fmt(min)}${cur ? ` ${cur}` : ""}`;
  if (max !== undefined) return `up to ${fmt(max)}${cur ? ` ${cur}` : ""}`;
  return null;
}

const compText = formatComp();
const postedText = role.posted_at ? relativeDate(role.posted_at) : null;
---

<BaseLayout
  title={fullTitle}
  description={description}
  current="browse"
  totalRoles={totalRoles}
  builtAtIso={builtAtIso}
>
  <article class="role">
    <p class="back-link">
      <a href={`${base}/`}>← Back to all roles</a>
    </p>

    <header class="role-header">
      <h1>{role.title}</h1>
      <p class="role-meta">
        <a class="company" href={`${base}/tenant/${role.ats}/${role.tenant_slug}/`}>
          {role.company}
        </a>
        {role.department && (<><span class="dot" aria-hidden="true">·</span><span>{role.department}</span></>)}
        {role.level && (<><span class="dot" aria-hidden="true">·</span><span class="cap">{role.level}</span></>)}
        {role.workplace_type && (<><span class="dot" aria-hidden="true">·</span><span class="cap">{role.workplace_type}</span></>)}
        {role.location_text && (<><span class="dot" aria-hidden="true">·</span><span>{role.location_text}</span></>)}
      </p>
      {postedText
        ? <p class="role-dates muted">Posted {postedText}</p>
        : <p class="role-dates muted">First seen {relativeDate(role.first_seen_at)}</p>}

      {compText && <p class="role-comp">{compText}</p>}

      {role.is_stale && (
        <p class="stale-banner">
          This role was carried forward from a previous build — its source ATS may have stopped serving it.
        </p>
      )}

      {role.is_recruiter_post && (
        <p class="muted recruiter-tag">Posted by an external recruiter / agency</p>
      )}

      <div class="role-cta">
        <a class="apply-cta" href={role.url} target="_blank" rel="noopener noreferrer">
          Apply on {atsPretty} →
        </a>
        <RoleActions client:idle id={role.id} />
      </div>
    </header>

    {role.description_excerpt ? (
      <section class="role-body">
        <h2>Description</h2>
        <p>{role.description_excerpt}</p>
      </section>
    ) : (
      <section class="role-body">
        <p class="muted">
          No description available from the source ATS. Open the apply link to view the full posting.
        </p>
      </section>
    )}

    <footer class="role-footer">
      <p class="muted">
        Apply on <strong>{atsPretty}</strong> · Source: <code>{sourceHost}</code>
      </p>
      <p class="muted small">
        This page is a filtered view of the original posting on the company's ATS. openroles does not host applications and adds no tracking parameters.
      </p>
    </footer>
  </article>

  {jsonLd !== null && (
    <script type="application/ld+json" is:inline set:html={jsonLdSafe(jsonLd)} />
  )}
</BaseLayout>

<style>
  .role {
    display: grid;
    gap: var(--space-3);
    max-inline-size: 65ch;
    margin-block-end: var(--space-5);
  }
  .back-link {
    margin: 0;
  }
  .role-header {
    display: grid;
    gap: var(--space-2);
  }
  h1 {
    font-size: var(--font-size-3);
    line-height: 1.15;
    margin: 0;
  }
  h2 {
    font-size: var(--font-size-2);
    margin-block-end: var(--space-1);
  }
  .role-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: baseline;
    margin: 0;
  }
  .company {
    font-weight: 600;
  }
  .dot {
    color: var(--color-muted);
  }
  .cap {
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    font-size: var(--font-size-0);
  }
  .role-dates,
  .role-comp,
  .recruiter-tag {
    margin: 0;
  }
  .role-comp {
    font-variant-numeric: tabular-nums;
  }
  .stale-banner {
    background: var(--color-surface-2);
    border-inline-start: 3px solid var(--color-accent);
    padding: var(--space-2);
    margin: 0;
  }
  .role-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
  }
  .apply-cta {
    font-weight: 700;
  }
  .role-body p {
    white-space: pre-wrap;
  }
  .role-footer {
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-2);
  }
  .small {
    font-size: var(--font-size-0);
  }
  .muted {
    color: var(--color-muted);
  }
</style>
