---
export const prerender = true;

// Tenant pages are temporarily disabled while the client-side DB load
// is being stabilised. Pre-rendering ~119k tenant pages adds ~40 min
// to every deploy, which is unworkable iteration latency. Returning
// an empty path set keeps the route registered (no 500s) while the
// build emits zero pages. Restore the previous implementation
// (selectTenants + per-tenant SSG) once the homepage filter UI is
// reliably loading roles.
export async function getStaticPaths() {
  return [];
}

const company = "";
const ats = "";
const slug = "";
const homepageUrl: string | null = null;
const status = "";
const jobCount = 0;
const jobs: Array<{
  url: string;
  title: string;
  level: string | null;
  workplace_type: string | null;
  location_text: string | null;
  posted_at: string | null;
}> = [];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{company} jobs · openroles</title>
    <meta
      name="description"
      content={`Open roles at ${company} (${ats} · ${slug}). ${jobCount} listings tracked.`}
    />
    <link rel="alternate" type="application/rss+xml" title={`openroles — ${ats}`} href={`${base}/feed/${ats}.xml`} />
    <link rel="stylesheet" href={`${base}/styles/global.css`} />
  </head>
  <body>
    <header class="site-header">
      <a href={`${base}/`} class="brand">openroles</a>
    </header>
    <main class="tenant-page">
      <h1>{company}</h1>
      <p class="meta">
        <span>{ats}</span>
        <span>·</span>
        <span>{slug}</span>
        {homepageUrl ? <><span>·</span><a href={homepageUrl} rel="nofollow noopener">site</a></> : null}
        <span>·</span>
        <span>status: {status}</span>
      </p>
      <p class="count">{jobCount} listing{jobCount === 1 ? "" : "s"}</p>
      {jobs.length === 0 ? (
        <p>No active listings.</p>
      ) : (
        <ul role="list" class="jobs">
          {jobs.map((j) => (
            <li class="job">
              <a href={j.url} rel="nofollow noopener">{j.title}</a>
              <p class="job-meta">
                {j.level ?? "unclassified"}
                {j.workplace_type ? <> · {j.workplace_type}</> : null}
                {j.location_text ? <> · {j.location_text}</> : null}
                {j.posted_at ? <> · posted {j.posted_at.slice(0, 10)}</> : null}
              </p>
            </li>
          ))}
        </ul>
      )}
    </main>
  </body>
</html>
